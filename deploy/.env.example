# Image deployed by Compose. CI replaces this with the immutable commit tag.
APP_IMAGE=ghcr.io/your-github-owner/revenuecheck:latest

# Bind to 127.0.0.1 when a TLS reverse proxy runs on the host. Change to
# 0.0.0.0 only if firewall rules explicitly restrict public access.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

POSTGRES_DB=revenuecheck
POSTGRES_USER=revenuecheck
POSTGRES_PASSWORD=replace_with_a_long_random_password

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

OPENAI_API_KEY=sk-proj-replace_me
OPENAI_MODEL=gpt-5-mini

RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=RevenueCheck <reports@your-verified-domain.com>
REPORT_RECIPIENT_EMAIL=alesemichael641@gmail.com

NEXT_PUBLIC_BOOKING_URL=https://your-booking-provider.example/revenue-recovery
