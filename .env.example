# Clerk dashboard > API keys. The publishable key is safe for the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Keep this server-side. Never prefix it with NEXT_PUBLIC_.
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk dashboard > API keys > JWKS URL. Used by FastAPI to verify session JWTs.
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# OpenAI server-side key and model. Never expose either with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-proj-replace_me
OPENAI_MODEL=gpt-5-mini

# PostgreSQL connection string. SSL is normally required by hosted providers.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/revenuecheck?sslmode=require

# Resend API credentials used to email completed assessments to t-Consult.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=RevenueCheck <reports@your-verified-domain.com>
REPORT_RECIPIENT_EMAIL=alesemichael641@gmail.com

# Optional local FastAPI address.
API_BASE_URL=http://127.0.0.1:8000

# Optional browser override. Local development already defaults to this URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Optional; otherwise the CTA opens an email.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/replace-me/revenue-recovery
